# ================== OBRIGATÓRIAS ==================
# Gere valores aleatórios, por exemplo:  openssl rand -hex 24
POSTGRES_PASSWORD=troque_esta_senha
# Token que TODOS os agentes T.I.A. usam para enviar dados (vai no .env distribuído pela GPO como CENTRAL_TOKEN)
AGENT_TOKEN=troque_este_token
# Senha do usuário somente-leitura que o Grafana usa no banco
GRAFANA_RO_PASSWORD=troque_esta_senha
# Senha do usuário "admin" do Grafana
GRAFANA_ADMIN_PASSWORD=troque_esta_senha

# Endereço pelo qual o T.I. acessa o Grafana (usado nos links dos chamados)
GRAFANA_PUBLIC_URL=http://10.0.0.50:3000
TZ=America/Sao_Paulo

# Portas publicadas no servidor
API_PORT=8000
GRAFANA_PORT=3000

# ================== GLPI ==================
# Sem estas três variáveis os alertas ficam só no painel, sem abrir chamado.
GLPI_URL=https://glpi.empresa.local/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
# Opcionais (IDs do GLPI):
GLPI_ENTITY_ID=
GLPI_CATEGORY_ID=
GLPI_ASSIGN_GROUP_ID=
# Soluciona o chamado automaticamente quando o indicador normaliza (false = só adiciona acompanhamento)
GLPI_AUTO_SOLVE=true
# false se o GLPI usa certificado autoassinado
GLPI_VERIFY_TLS=true

# ================== REGRAS DE ALERTA ==================
ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=95
ALERT_SUSTAINED_MINUTES=10
ALERT_NET_MBPS=50
ALERT_NET_MINUTES=15
ALERT_NET_DAILY_GB=20
# Checks do health check que NÃO abrem chamado
HEALTH_ALERT_IGNORE=cpu,memory,collector,battery
# Máquina que some durante o expediente (desligado por padrão: desktops desligados geram ruído)
ALERT_OFFLINE_ENABLED=false
ALERT_OFFLINE_MINUTES=15
BUSINESS_HOURS=08:00-18:00

RETENTION_DAYS=30
