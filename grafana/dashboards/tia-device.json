{
  "uid": "tia-device",
  "title": "T.I.A. — Detalhe da máquina",
  "tags": [
    "tia"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Máquina",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "tia-pg"
        },
        "query": "SELECT hostname FROM devices ORDER BY 1",
        "definition": "SELECT hostname FROM devices ORDER BY 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Identificação",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tia-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT hostname AS \"Máquina\", online::text AS \"Status\", health AS \"Saúde\", username AS \"Usuário\", ip AS \"IP\",\n       os AS \"Sistema\", agent_version AS \"Agente\", last_seen AS \"Último contato\", health_ts AS \"Último health check\"\nFROM device_overview WHERE hostname = '$host'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "warn": {
                        "text": "Atenção",
                        "color": "#F2CC0C",
                        "index": 1
                      },
                      "crit": {
                        "text": "Crítico",
