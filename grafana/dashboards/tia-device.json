    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU e memória",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tia-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT ts AS time, cpu AS \"CPU\", mem_percent AS \"Memória RAM\"\nFROM metrics WHERE hostname = '$host' AND $__timeFilter(ts) ORDER BY ts",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rede",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tia-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT ts AS time, rx_bytes * 8 / 60.0 AS \"Download\", tx_bytes * 8 / 60.0 AS \"Upload\"\nFROM metrics WHERE hostname = '$host' AND $__timeFilter(ts) ORDER BY ts",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Último health check",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tia-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT c->>'label' AS \"Verificação\", c->>'value' AS \"Valor\", c->>'status' AS \"Situação\", c->>'hint' AS \"Orientação\"\nFROM (SELECT checks FROM health_reports WHERE hostname = '$host' ORDER BY ts DESC LIMIT 1) r,\n     jsonb_array_elements(r.checks) c\nORDER BY CASE c->>'status' WHEN 'crit' THEN 0 WHEN 'warn' THEN 1 ELSE 2 END",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Situação"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "warn": {
                        "text": "Atenção",
                        "color": "#F2CC0C",
                        "index": 1
                      },
                      "crit": {
                        "text": "Crítico",
                        "color": "red",
                        "index": 2
                      },
                      "true": {
                        "text": "Online",
                        "color": "green",
                        "index": 3
                      },
                      "false": {
                        "text": "Offline",
                        "color": "red",
                        "index": 4
                      },
                      "open": {
                        "text": "Aberto",
                        "color": "red",
                        "index": 5
                      },
                      "resolved": {
                        "text": "Normalizado",
                        "color": "green",
                        "index": 6
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Programas usando mais memória",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tia-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 11,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT p->>'name' AS \"Processo\", (p->>'mem_mb')::int AS \"Memória (MB)\"\nFROM (SELECT top_processes FROM health_reports WHERE hostname = '$host' ORDER BY ts DESC LIMIT 1) r,\n     jsonb_array_elements(r.top_processes) p",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Consumo de rede por dia",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tia-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT date_trunc('day', ts) AS time, sum(rx_bytes) AS \"Baixado\", sum(tx_bytes) AS \"Enviado\"\nFROM metrics WHERE hostname = '$host' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
