      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT a.hostname AS \"Máquina\", a.severity AS \"Nível\", a.title AS \"Alerta\", a.details AS \"Detalhes\",\n       a.opened_at AS \"Desde\", a.glpi_ticket_id AS \"Chamado GLPI\", a.glpi_error AS \"Erro GLPI\"\nFROM alerts a WHERE a.status = 'open'\nORDER BY CASE a.severity WHEN 'crit' THEN 0 ELSE 1 END, a.opened_at DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "",
