    {
      "id": 9,
      "type": "timeseries",
      "title": "Top 10 consumo de rede (download + upload)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tia-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT $__timeGroupAlias(ts, '5m'), hostname AS metric, sum(rx_bytes + tx_bytes) * 8 / 300.0 AS value\nFROM metrics\nWHERE $__timeFilter(ts) AND hostname IN (\n    SELECT hostname FROM metrics WHERE $__timeFilter(ts)\n    GROUP BY hostname ORDER BY sum(rx_bytes + tx_bytes) DESC LIMIT 10)\nGROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
