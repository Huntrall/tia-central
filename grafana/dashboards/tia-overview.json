      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tia-pg"
          },
          "rawSql": "\nSELECT hostname AS \"Máquina\", online::text AS \"Status\", health AS \"Saúde\", username AS \"Usuário\", ip AS \"IP\",\n       cpu AS \"CPU\", mem_percent AS \"RAM\", round((uptime_hours / 24)::numeric, 1) AS \"Dias ligado\",\n       today_bytes AS \"Rede hoje\", open_alerts AS \"Alertas\", agent_version AS \"Agente\", last_seen AS \"Último contato\"\nFROM device_overview\nORDER BY open_alerts DESC, CASE health WHEN 'crit' THEN 0 WHEN 'warn' THEN 1 ELSE 2 END, hostname",
